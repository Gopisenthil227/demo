import torch
import torchvision
from torchvision import transforms
import matplotlib.pyplot as plt

# Load MNIST sample
mnist = torchvision.datasets.MNIST(root='./data', train=True, download=True)
img, _ = mnist[0]

# Define transformations
augmentations = [
    transforms.Compose([]),  # Original
    transforms.Compose([transforms.RandomRotation(degrees=30)]),
    transforms.Compose([transforms.RandomRotation(degrees=(-30, -30))]),
    transforms.Compose([transforms.RandomHorizontalFlip(p=1.0)]),
    transforms.Compose([transforms.RandomVerticalFlip(p=1.0)]),
    transforms.Compose([
        transforms.RandomRotation(degrees=180),
        transforms.RandomHorizontalFlip(p=1.0)
    ]),
]

# Apply and display
plt.figure(figsize=(10, 4))
for i, aug in enumerate(augmentations):
    transformed_img = aug(img)
    plt.subplot(2, 3, i + 1)
    plt.imshow(transformed_img, cmap='gray')
    plt.axis('off')
plt.suptitle("MNIST Augmented Images")
plt.tight_layout()
plt.show()


4... CNN - traffic

import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader, TensorDataset
import random

# Simulated data: 100 RGB images of 64x64 and 3 traffic sign classes
num_classes = 3
classes = ['STOP', 'YIELD', 'SPEED_LIMIT']
X = torch.randn(100, 3, 64, 64)  # fake images
y = torch.randint(0, num_classes, (100,))  # fake labels

# Define a simple CNN
class TrafficNet(nn.Module):
    def __init__(self):
        super().__init__()
        self.conv1 = nn.Conv2d(3, 8, 3)
        self.pool = nn.MaxPool2d(2)
        self.fc1 = nn.Linear(8 * 31 * 31, num_classes)

    def forward(self, x):
        x = self.pool(F.relu(self.conv1(x)))
        x = x.view(x.size(0), -1)
        return self.fc1(x)

# Training setup
model = TrafficNet()
optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
loss_fn = nn.CrossEntropyLoss()
loader = DataLoader(TensorDataset(X, y), batch_size=10, shuffle=True)

# Train briefly (offline)
for _ in range(2):  # 2 epochs
    for xb, yb in loader:
        optimizer.zero_grad()
        loss = loss_fn(model(xb), yb)
        loss.backward()
        optimizer.step()

# Predict 1 image
model.eval()
sample = X[0].unsqueeze(0)
prediction = model(sample).argmax(1).item()
print(f"Predicted Traffic Sign: {classes[prediction]}")

