1... Derive a top-down, depth-first,

grammar = {
    'S': [['NP', 'VP']],
    'NP': [['Det', 'Nom']],
    'VP': [['V', 'NP']],
    'Nom': [['Adj', 'Nom'], ['N']],
    'Det': ['the'],
    'Adj': ['little', 'angry', 'frightened'],
    'N': ['squirrel', 'bear'],
    'V': ['chased']
}

words = ['the', 'angry', 'bear', 'chased', 'the', 'frightened', 'little', 'squirrel']
i = 0

def parse(symbol):
    global i
    if symbol in grammar and isinstance(grammar[symbol][0], list):
        for rule in grammar[symbol]:
            pos = i
            nodes = []
            for sym in rule:
                node = parse(sym)
                if not node:
                    i = pos
                    break
                nodes.append(node)
            else:
                return [symbol] + nodes
    elif i < len(words) and words[i] in grammar.get(symbol, []):
        node = [symbol, words[i]]
        i += 1
        return node
    return None

def show(node, indent=0):
    if node:
        print('  ' * indent + node[0])
        for child in node[1:]:
            show(child, indent + 1)

show(parse('S'))

2... Create the grammar rules

G = {
  'S': [['NP', 'VP']],
  'NP': [['Det', 'Nominal'], ['N']],
  'VP': [['V', 'NP']],
  'Det': ['A'],
  'Nominal': [['N']],
  'N': ['Restaurant', 'Dosa'],
  'V': ['Serves']
}
W = ['A', 'Restaurant', 'Serves', 'Dosa']
i = 0

def parse(s):
  global i
  if s in G and type(G[s][0]) == list:
    for rule in G[s]:
      pos = i
      r = []
      for sym in rule:
        t = parse(sym)
        if not t:
          i = pos
          break
        r.append(t)
      else:
        return [s] + r
  elif i < len(W) and W[i] in G.get(s, []):
    i += 1
    return [s, W[i-1]]
  return None

def show(t, l=0):
  if t:
    print(' '*l + t[0])
    for x in t[1:]: show(x, l+2)

show(parse('S'))


3... Minimum edit distance

str1 = 'Saturday'
str2 = 'Sunday'
m = len(str1)
n = len(str2)
dp = [[0]* (n+1) for _ in range(m+1)]

for i in range(m+1):
  for j in range(n+1):
    if i == 0: dp[i][j] = j
    elif j == 0: dp[i][j] = i
    elif str1[i-1] == str2[j-1]:
      dp[i][j] = dp[i-1][j-1]
    else:
      dp[i][j] = 1 + min(dp[i-1][j], dp[i][j-1], dp[i-1][j-1])

print("Minimum edit distance:", dp[m][n])

